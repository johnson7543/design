{
  "name": "design",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:designqr && npm run build:web",
    "build:web": "tsc -b && vite build",
    "build:designqr": "npm run build --workspace designqr",
    "build:designqr-consumer": "tsc -p examples/react-vite-consumer/tsconfig.json && vite build --config examples/react-vite-consumer/vite.config.ts",
    "build:designqr-iframe-consumer": "tsc -p examples/iframe-consumer/tsconfig.json && vite build --config examples/iframe-consumer/vite.config.ts",
    "lint": "oxlint",
    "docs:check": "node scripts/check-docs.mjs",
    "design-docs:check": "node scripts/check-design-docs.mjs",
    "color:check": "node scripts/check-colors.mjs",
    "style:check": "node scripts/check-design-qr-styles.mjs",
    "test:designqr": "npm run test --workspace designqr",
    "typecheck:designqr": "npm run typecheck --workspace designqr",
    "release:designqr:check": "node scripts/check-designqr-release.mjs",
    "audit:designqr-package": "node scripts/audit-designqr-package.mjs",
    "preview": "vite preview",
    "init:demo": "node scripts/init-demo-video-scenario.mjs",
    "verify:demo": "node scripts/verify-demo-video.mjs",
    "record:demo": "npm run build && node scripts/record-demo-video.mjs",
    "record:qr-preview": "npm run record:demo -- --scenario scripts/demo-video-scenarios/design-qr.json",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:designqr-consumer": "node scripts/smoke-designqr-consumer.mjs",
    "smoke:designqr-embed": "node scripts/smoke-designqr-embed.mjs",
    "check": "npm run lint && npm run test:designqr && npm run typecheck:designqr && npm run docs:check && npm run design-docs:check && npm run color:check && npm run style:check && npm run build && npm run build:designqr-consumer && npm run build:designqr-iframe-consumer && npm run smoke:designqr-consumer && npm run smoke:designqr-embed && npm run smoke:production",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "designqr": "*",
    "lucide-react": "^1.34.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "puppeteer-core": "^25.9.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
