{
  "version": 1,
  "id": "pullground-social",
  "product": "Pullground",
  "description": "An unmodified full-page recording of the real Pullground demo for sharing on X. Show the animated Pull guide, basket, backboard smash, dart, bowling, and stone skipping, using the visible game controls. Keep the header, GitHub control, theme row, and Export button in view. No injected CSS, crop, editorial overlays, or retiming. Pulls use 1.5\u20131.7 second eased real touch gestures with a brief 160 ms aim hold, recorded at native 60 fps.",
  "route": "/pullground",
  "windowTitle": "Pullground",
  "readySelector": ".pullground-demo-viewport",
  "settleMs": 1500,
  "viewport": {
    "width": 450,
    "height": 800,
    "deviceScaleFactor": 2,
    "isMobile": true,
    "hasTouch": true
  },
  "recording": {
