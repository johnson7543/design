    "output": "artifacts/pullground/social/pullground-x.mp4",
    "poster": "artifacts/pullground/social/pullground-x-cover.jpg",
    "posterAtSeconds": 3.1,
    "size": {
      "width": 900,
      "height": 1600
    },
    "crf": 18
  },
  "quality": {
