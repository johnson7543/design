        "scripts/build-city-label-font.py",
        "src/App.tsx",
        "src/components",
        "src/editor",
        "src/index.css",
        "src/utils"
      ],
      "docsDirectory": "docs/designqr-editor",
      "documents": {
        "index": "README.md",
        "style": "style-principles.md",
        "colors": "color-mappings.md"
      }
