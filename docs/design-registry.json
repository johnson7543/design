        "public/favicon",
        "src/main.tsx",
        "src/platform",
        "src/platform.css",
        "public/previews"
      ],
      "docsDirectory": "docs/home-page",
      "documents": {
        "index": "README.md",
        "style": "style-principles.md",
        "colors": "color-mappings.md"
      }
    },
    {
      "id": "designqr-package",
